// Generates Return to Sender's months ahead into data/return-to-sender/months/, one file per month, and rewrites the
// index the app loads them through. Every built board gets a puzzle each day. A month already on disk keeps every
// puzzle it has and only gains puzzles for boards built since; --force regenerates it from scratch. Every month is
// checked before it is saved, so a puzzle never changes once players may have seen it.
//
//   npm run return-to-sender:months -- 2026-10 2026-12     (an inclusive range of months)
//   npm run return-to-sender:months -- 2026-11 --force     (regenerate one month)

import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { PUZZLE_VERSION, checkMonth, generateMonth, type MonthFile } from "../components/games/return-to-sender/schedule.ts";

const dir = path.resolve("data/return-to-sender/months");
const args = process.argv.slice(2).filter((a) => !a.startsWith("--"));
const force = process.argv.includes("--force");
const [from, to = from] = args;
if (!from || !/^\d{4}-\d{2}$/.test(from) || !/^\d{4}-\d{2}$/.test(to!)) {
  console.error("Usage: npm run return-to-sender:months -- YYYY-MM [YYYY-MM] [--force]");
  process.exit(1);
}

const months: string[] = [];
for (let [y, m] = from.split("-").map(Number) as [number, number]; `${y}-${String(m).padStart(2, "0")}` <= to!; m === 12 ? ((y += 1), (m = 1)) : (m += 1)) {
  months.push(`${y}-${String(m).padStart(2, "0")}`);
}

mkdirSync(dir, { recursive: true });
for (const monthKey of months) {
  const file = path.join(dir, `${monthKey}.json`);
  const old = existsSync(file) && !force ? (JSON.parse(readFileSync(file, "utf8")) as MonthFile) : undefined;
  if (old && old.version !== PUZZLE_VERSION) {
    console.error(`${monthKey}: the file on disk is version ${old.version}; regenerate it with --force.`);
    process.exit(1);
  }
  const month = generateMonth(monthKey, old);
  const problems = checkMonth(month);
  if (problems.length) {
    console.error(`${monthKey}: ${problems.length} problems, nothing saved:\n  ${problems.slice(0, 20).join("\n  ")}`);
    process.exit(1);
  }
  const text = JSON.stringify(month);
  if (old && JSON.stringify(old) === text) {
    console.log(`${monthKey}: kept (already has every board)`);
    continue;
  }
  writeFileSync(file, text);
  console.log(`${monthKey}: ${old ? "added the new boards" : "generated"}, ${month.days.length} days`);
}

// The index imports each month by name, so the server bundle includes exactly the generated months.
const keys = readdirSync(dir)
  .filter((f) => /^\d{4}-\d{2}\.json$/.test(f))
  .map((f) => f.slice(0, 7))
  .sort();
writeFileSync(
  path.join(dir, "index.ts"),
  `// Generated by scripts/return-to-sender-months.mts; do not edit by hand.\n\nexport const MONTH_FILES: Record<string, () => Promise<{ default: unknown }>> = {\n${keys
    .map((k) => `  "${k}": () => import("./${k}.json"),`)
    .join("\n")}\n};\n`,
);
console.log(`index: ${keys.length} months`);
