// Generates Snug's month quilts ahead of time into data/snug/months/, one file per month, and rewrites the index
// the server loads them through. Every month is checked against every rule before it is saved; existing months are
// left alone unless --force is given, so a month never changes once players may have seen it.
//
//   npm run snug:months -- 2026-10 2027-12          (an inclusive range of months)
//   npm run snug:months -- 2027-03 --force          (regenerate one month)

import { existsSync, readdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { checkMonth, generateOutlineMonth, outlineFor, type MonthFile } from "../components/games/snug/outline.ts";
import { YARNS } from "../components/games/snug/palette.ts";
import { PUZZLE_VERSION } from "../components/games/snug/version.ts";

const dir = path.resolve("data/snug/months");
const args = process.argv.slice(2).filter((a) => !a.startsWith("--"));
const force = process.argv.includes("--force");
const [from, to = from] = args;
if (!from || !/^\d{4}-\d{2}$/.test(from) || !/^\d{4}-\d{2}$/.test(to!)) {
  console.error("Usage: npm run snug:months -- YYYY-MM [YYYY-MM] [--force]");
  process.exit(1);
}

const months: string[] = [];
for (let [y, m] = from.split("-").map(Number) as [number, number]; `${y}-${String(m).padStart(2, "0")}` <= to!; m === 12 ? ((y += 1), (m = 1)) : (m += 1)) {
  months.push(`${y}-${String(m).padStart(2, "0")}`);
}

for (const monthKey of months) {
  const file = path.join(dir, `${monthKey}.json`);
  if (existsSync(file) && !force) {
    console.log(`${monthKey}: kept (already generated)`);
    continue;
  }
  const outline = outlineFor(monthKey);
  const started = Date.now();
  let month: MonthFile | null = null;
  // A month that does not come together, or breaks a rule, just tries the next seed.
  for (let seed = 0; !month; seed++) {
    try {
      const q = generateOutlineMonth(monthKey, outline, YARNS.length, `v${PUZZLE_VERSION}-${seed}`);
      const candidate: MonthFile = { version: PUZZLE_VERSION, monthKey, outline, minX: q.minX, minY: q.minY, width: q.width, height: q.height, days: q.days };
      if (checkMonth(candidate).length === 0) month = candidate;
    } catch {
      // No month from this seed; try the next one.
    }
  }
  writeFileSync(file, JSON.stringify(month));
  console.log(`${monthKey}: ${outline}, ${month.days.length} days, ${Math.round((Date.now() - started) / 1000)}s`);
}

// The index imports each month by name, so the server bundle includes exactly the generated months.
const keys = readdirSync(dir)
  .filter((f) => /^\d{4}-\d{2}\.json$/.test(f))
  .map((f) => f.slice(0, 7))
  .sort();
writeFileSync(
  path.join(dir, "index.ts"),
  `// Generated by scripts/snug-months.mts; do not edit by hand.\n\nexport const MONTH_FILES: Record<string, () => Promise<{ default: unknown }>> = {\n${keys
    .map((k) => `  "${k}": () => import("./${k}.json"),`)
    .join("\n")}\n};\n`,
);
console.log(`index: ${keys.length} months`);
